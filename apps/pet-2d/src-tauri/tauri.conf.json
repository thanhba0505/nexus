{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pet_2D",
  "version": "0.5.0",
  "identifier": "com.thanhba.nexus.pet2d",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "2D Pet",
        "width": 800,
        "height": 550,
        "minWidth": 680,
        "minHeight": 450,
        "resizable": true,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "pet-overlay",
        "title": "2D Pet Mascot",
        "url": "index.html#/pet",
        "width": 240,
        "height": 240,
        "resizable": false,
        "center": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {}
  }
}
